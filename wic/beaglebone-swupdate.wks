# Short-description: SD card image for BeagleBone with A/B rootfs
# Partitions: 1: Boot (FAT), 2: RootfsA (ext4), 3: RootfsB (ext4)

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4 --fixed-size 32 --sourceparams="loader=u-boot" --use-uuid
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_a --align 4 --use-uuid --fixed-size 1G
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_b --align 4 --use-uuid --fixed-size 1G
bootloader --append="console=ttyS0,115200"
